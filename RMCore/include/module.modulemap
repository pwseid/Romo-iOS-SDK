module RMCore {
    umbrella header "RMCore.h"

    // Exclude all non-public headers from module compilation.
    // They remain in include/ so external consumers can #import them,
    // but they are not processed as module members.

    // Communication / transport
    exclude header "SerialProtocol.h"
    exclude header "RMCoreRobotDataTransport.h"
    exclude header "RobotCommunicationProtocol.h"
    exclude header "RMCoreRobotCommunication.h"
    exclude header "RMCoreRobotCommunicationOld.h"

    // Firmware / programming
    exclude header "RMProgrammingProtocol.h"
    exclude header "STK500Programmer.h"
    exclude header "IntelHexImage.h"
    exclude header "IntelHexLine.h"
    exclude header "EEPROMDefs.h"
    exclude header "Romo3Defs.h"

    // Type definitions
    exclude header "ChargingStates.h"
    exclude header "DeviceModes.h"
    exclude header "LEDModes.h"
    exclude header "MotorCommandTypes.h"
    exclude header "ParameterTypes.h"
    exclude header "InfoTypes.h"

    // Motion / sensing
    exclude header "RMCoreMotionInterface.h"
    exclude header "RMCoreDeviceMotion.h"
    exclude header "RMCorePlatformMotion.h"
    exclude header "RMCoreRobotMotion.h"
    exclude header "RMCoreBumpDetector.h"
    exclude header "RMCoreInertialStasis.h"
    exclude header "RMCoreStasisDetector.h"
    exclude header "RMCoreLeakyIntegrator.h"
    exclude header "RMCoreMovingAverage.h"

    // Drive
    exclude header "RMCoreDifferentialDrive.h"
    exclude header "RMCoreDriveController.h"
    exclude header "RMCoreHeadTilt.h"
    exclude header "HolonomicDriveProtocol.h"

    // Internal headers (class extensions)
    exclude header "RMCoreRobot_Internal.h"
    exclude header "RMCoreLEDs_Internal.h"
    exclude header "RMCoreMotor_Internal.h"
    exclude header "RMCoreRobotIdentification_Internal.h"
    exclude header "RMCoreRobotVitals_Internal.h"

    export *
}
