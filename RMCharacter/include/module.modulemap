module RMCharacter {
    umbrella header "RMCharacter.h"

    // Headers not imported by RMCharacter.h but still available via #import
    exclude header "RMCharacterAnimation.h"
    exclude header "RMCharacterColorFill.h"
    exclude header "RMCharacterEye.h"
    exclude header "RMCharacterFace.h"
    exclude header "RMCharacterFaceEmotion.h"
    exclude header "RMCharacterPNS.h"
    exclude header "RMCharacterProtectedView.h"
    exclude header "RMCharacterPupil.h"
    exclude header "RMCharacterVoice.h"
    exclude header "UIImage+Cache.h"

    export *
}
