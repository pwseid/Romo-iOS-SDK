module RMVision {
    umbrella header "RMVision.h"

    // Exclude all non-public headers from module compilation.
    // They remain in include/ so external consumers can #import them,
    // but they are not processed as module members.

    // GPUImage filters
    exclude header "GPUImageBrightColorNotchFilter.h"
    exclude header "GPUImageBrightHueSegmentation.h"
    exclude header "GPUImageCustomLookupFilter.h"
    exclude header "GPUImageFilter+RMAdditions.h"
    exclude header "GPUImageMaskToPixelPositionFilter.h"
    exclude header "GPUImageMotionSegmentation.h"
    exclude header "GPUImageNormalBayesFilter.h"
    exclude header "GPUImageRawDataInput+RMAdditions.h"

    // Vision modules
    exclude header "RMBrightnessMeteringModule.h"
    exclude header "RMEyeDetectionModule.h"
    exclude header "RMFaceDetectionModule.h"
    exclude header "RMFakeVision.h"
    exclude header "RMGPUImageExampleModule.h"
    exclude header "RMLineDetectionModule.h"
    exclude header "RMMotionDetectionModule.h"
    exclude header "RMMotionTriggeredColorTrainingModule.h"
    exclude header "RMThroughRomosEyesModule.h"
    exclude header "RMVisionBrightHueSegmentationModule.h"
    exclude header "RMVisionNaiveLineTrainingModule.h"
    exclude header "RMVisionObjectTrackingModule.h"
    exclude header "RMVisionObjectTrackingModuleDebug.h"
    exclude header "RMVisualStasisDetectionModule.h"
    exclude header "RMPictureModule.h"
    exclude header "RMVideoModule.h"
    exclude header "RMVisionModule.h"

    // Utilities
    exclude header "RMBorderView.h"
    exclude header "RMImageUtils.h"
    exclude header "RMNormalBayes.h"
    exclude header "RMOpenCVUtils.h"
    exclude header "RMVisionDebugBroker.h"
    exclude header "UIImage+OpenCV.h"

    // Internal
    exclude header "RMVision_Internal.h"

    export *
}
